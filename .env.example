# Copy to .env.local and fill in. Never commit real values.
# Supabase dashboard → Project dwgpfheyfaovmclswwlg → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://dwgpfheyfaovmclswwlg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Digest delivery (lib/delivery). Each channel is optional; without it, digests are still built and viewable on the web.
# Email via Resend. Without a verified domain, Resend only delivers to its own account's address.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
# WhatsApp demo via Meta's Cloud API test number (up to 5 approved recipients)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Vercel cron for /api/cron/digests sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
