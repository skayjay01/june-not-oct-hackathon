# Copy to .env.local and fill in. Never commit real values.
# Supabase dashboard → Project dwgpfheyfaovmclswwlg → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://dwgpfheyfaovmclswwlg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Digest delivery (lib/delivery). Each channel is optional; without it, digests are still built and viewable on the web.
# Email from a Gmail account (Google Account → Security → App passwords); used instead of Resend when set.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Or email via Resend. Without a verified domain, Resend only delivers to its own account's address.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
# WhatsApp demo via Meta's Cloud API test number (up to 5 approved recipients)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Vercel cron (vercel.json, daily 14:00 UTC) calls /api/cron/digests with "Authorization: Bearer $CRON_SECRET";
# each brand is sent its digest when due (daily or weekly, per its Settings).
CRON_SECRET=
